{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "your-etsy-mcp-worker",
  "main": "src/seller.ts",
  "compatibility_date": "2026-10-02",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "vars": {
    "ETSY_REDIRECT_URI": "https://your-domain.example/etsy/callback"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "routes": [
    { "pattern": "your-domain.example", "custom_domain": true }
  ],
  "kv_namespaces": [
    { "binding": "OAUTH_KV", "id": "REPLACE_WITH_YOUR_KV_NAMESPACE_ID" }
  ],
  "ratelimits": [
    { "name": "PUBLIC_SEARCH_LIMIT", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } },
    { "name": "PUBLIC_SEARCH_GLOBAL_LIMIT", "namespace_id": "1002", "simple": { "limit": 120, "period": 60 } }
  ]
}
